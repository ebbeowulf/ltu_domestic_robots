<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stretch_experiments</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="hello-robot@todo.todo">hello-robot</maintainer>
  <license>TODO: License declaration</license>

  <!-- Core ROS2 Python client -->
  <depend>rclpy</depend>

  <!-- ROS messages -->
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- ROS services -->
  <depend>std_srvs</depend>
  <depend>stretch_srvs</depend>

  <!-- ROS utilities -->
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>

  <!-- Python scientific stack (runtime only, installed via pip/apt) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <exec_depend>python3-open3d</exec_depend>
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-transformers</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <!-- Test dependencies (optional) -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
