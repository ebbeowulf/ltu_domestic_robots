from launch import LaunchDescription
from launch_ros.actions import Node

def generate_launch_description():
    return LaunchDescription([

        # First node
        Node(
            package='pkg',
            executable='type',
            name='name',
            arguments=['args']
        ),

        # Depth Cloud Only (commented out in ROS1, kept here as reference)
        # Node(
        #     package='depth_image_proc',
        #     executable='point_cloud_xyz',
        #     name='depth_cloud_xyz',
        #     remappings=[
        #         ('camera_info', '/camera_throttled/depth/camera_info'),
        #         ('image_rect', '/camera_throttled/depth/image_rect_raw'),
        #         ('points', '/camera_throttled/depth/points')
        #     ]
        # ),

        # RGB-D Cloud
        Node(
            package='depth_image_proc',
            executable='point_cloud_xyzrgb',
            name='rgbd_cloud',
            remappings=[
                ('rgb/camera_info', '/camera_throttled/color/camera_info'),
                ('depth_registered/image_rect', '/camera_throttled/depth/image_rect_raw'),
                ('rgb/image_rect_color', '/camera_throttled/color/image_raw'),
                ('depth_registered/points', '/camera_throttled/depth/color/points')
            ]
        )
    ])
